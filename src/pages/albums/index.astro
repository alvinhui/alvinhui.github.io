---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/utils';
import { getAlbums, groupAlbumsByYear } from '../../lib/albums';

const PREVIEW_LIMIT = 3;

const albums = getAlbums();
const albumsByYear = groupAlbumsByYear(albums);
const years = Object.keys(albumsByYear).sort((a, b) => Number(b) - Number(a));
const totalCount = albums.reduce((sum, a) => sum + a.count, 0);

const albumsByYearPayload = Object.fromEntries(
  years.map((year) => [
    year,
    albumsByYear[year].map((album) => ({
      folder: album.folder,
      name: album.name,
      dateISO: album.date.toISOString(),
      dateLabel: formatDate(album.date),
      count: album.count,
      coverSrc: album.cover.src,
      coverWidth: album.cover.width,
      coverHeight: album.cover.height,
    })),
  ])
);
---

<BaseLayout title="相册">
  <h1 class="text-3xl font-bold text-text dark:text-text-dark mb-2 text-center">相册</h1>
  <p class="text-muted dark:text-muted-dark mb-8 text-center">共 {albums.length} 个相册，{totalCount} 张照片</p>

  {years.map((year) => {
    const yearAlbums = albumsByYear[year];
    const hasMore = yearAlbums.length > PREVIEW_LIMIT;

    return (
      <section id={`year-${year}`} class="mb-16 scroll-mt-24" data-year-section={year}>
        <h2 class="text-xl font-bold text-text dark:text-text-dark mb-8 flex items-center gap-3">
          <span class="flex items-center gap-3">
            {year}
            <span class="text-sm font-normal text-muted dark:text-muted-dark">({yearAlbums.length} 个相册)</span>
          </span>
          {hasMore && (
            <a
              href={`/albums/year/${year}/`}
              class="ml-auto text-sm font-normal text-primary hover:underline"
            >
              更多
            </a>
          )}
        </h2>
        <div class="space-y-20" data-year-album-list={year}></div>
        <div
          class:list={['mt-12 text-center', !hasMore && 'hidden']}
          data-year-more={year}
        >
          <a
            href={`/albums/year/${year}/`}
            class="inline-flex items-center gap-2 text-base text-text dark:text-text-dark hover:text-primary transition-colors"
          >
            还有 <span data-remaining>{Math.max(0, yearAlbums.length - PREVIEW_LIMIT)}</span> 个相册
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    );
  })}

  {albums.length === 0 && (
    <p class="text-center text-muted dark:text-muted-dark py-16">暂无相册</p>
  )}

  {years.length > 0 && (
    <nav
      id="year-nav"
      class="hidden lg:flex fixed right-6 top-1/2 -translate-y-1/2 z-40 flex-col items-end gap-1"
      aria-label="年份导航"
    >
      {years.map((year) => (
        <a
          href={`#year-${year}`}
          data-year-link={year}
          class="px-2 py-1 text-sm text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
        >
          {year}
        </a>
      ))}
    </nav>
  )}

  <template id="album-card-template">
    <a
      href="#"
      class="group block w-full bg-white dark:bg-[#1a1a1a] border border-border dark:border-border-dark border-b-[3px] border-b-black dark:border-b-white hover:shadow-[0_-2px_0_0_#e5e7eb,-2px_0_0_0_#e5e7eb,2px_0_0_0_#e5e7eb] dark:hover:shadow-[0_-2px_0_0_#2d2d2d,-2px_0_0_0_#2d2d2d,2px_0_0_0_#2d2d2d] transition-shadow duration-200 pb-6"
    >
      <div class="px-10 pt-6 sm:px-16 sm:pt-10">
        <img
          src=""
          alt=""
          width="1"
          height="1"
          loading="lazy"
          class="w-full h-auto block"
        />
      </div>
      <div class="px-10 sm:px-16 mt-5 text-center">
        <h3 class="text-base font-normal text-text dark:text-text-dark group-hover:text-primary transition-colors"></h3>
        <div class="mt-3 mb-3 w-full border-t border-dashed border-border dark:border-border-dark"></div>
        <div class="flex items-center justify-center gap-3 text-sm text-muted dark:text-muted-dark">
          <time datetime=""></time>
          <span aria-hidden="true">·</span>
          <span data-count></span>
        </div>
      </div>
    </a>
  </template>
</BaseLayout>

<script define:vars={{ albumsByYearPayload, PREVIEW_LIMIT }}>
  const template = document.getElementById('album-card-template');

  function shuffle(list) {
    const arr = list.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function createCard(album) {
    const node = template.content.firstElementChild.cloneNode(true);
    node.href = `/albums/${album.folder}/`;

    const img = node.querySelector('img');
    img.src = album.coverSrc;
    img.width = album.coverWidth;
    img.height = album.coverHeight;
    img.alt = album.name;

    node.querySelector('h3').textContent = album.name;

    const time = node.querySelector('time');
    time.dateTime = album.dateISO;
    time.textContent = album.dateLabel;

    node.querySelector('[data-count]').textContent = `${album.count} 张`;
    return node;
  }

  if (template instanceof HTMLTemplateElement) {
    for (const [year, yearAlbums] of Object.entries(albumsByYearPayload)) {
      const list = document.querySelector(`[data-year-album-list="${year}"]`);
      const more = document.querySelector(`[data-year-more="${year}"]`);
      if (!list) continue;

      const picked = shuffle(yearAlbums).slice(0, PREVIEW_LIMIT);
      const fragment = document.createDocumentFragment();
      for (const album of picked) {
        fragment.appendChild(createCard(album));
      }
      list.appendChild(fragment);

      const remaining = yearAlbums.length - picked.length;
      if (more) {
        if (remaining > 0) {
          more.classList.remove('hidden');
          const remainingEl = more.querySelector('[data-remaining]');
          if (remainingEl) remainingEl.textContent = String(remaining);
        } else {
          more.classList.add('hidden');
        }
      }
    }
  }

  const sections = Array.from(document.querySelectorAll('[data-year-section]'));
  const links = Array.from(document.querySelectorAll('[data-year-link]'));

  if (sections.length > 0 && links.length > 0) {
    const activeClass = ['text-black', 'dark:text-white', 'font-bold'];
    const inactiveClass = ['text-muted', 'dark:text-muted-dark', 'font-normal'];

    function setActive(year) {
      for (const link of links) {
        const isActive = link.getAttribute('data-year-link') === year;
        link.classList.remove(...(isActive ? inactiveClass : activeClass));
        link.classList.add(...(isActive ? activeClass : inactiveClass));
        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    }

    function updateActiveFromScroll() {
      const marker = window.innerHeight * 0.3;
      let current = sections[0].getAttribute('data-year-section');

      for (const section of sections) {
        const top = section.getBoundingClientRect().top;
        if (top <= marker) {
          current = section.getAttribute('data-year-section');
        }
      }

      if (current) setActive(current);
    }

    setActive(sections[0].getAttribute('data-year-section'));
    updateActiveFromScroll();
    window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
    window.addEventListener('resize', updateActiveFromScroll);
  }
</script>
